rules_version = '2';

// Regras do portfólio — cole em: Firebase Console → Firestore Database → Regras → Publicar.
//
// Senha do dia = (dia × 100 + mês) + 2003, no horário de Brasília (UTC-3).
// Ex.: 08/10 → 810 + 2003 = 2813.
//
// Toda escrita é um batch que inclui um comprovante:
//   adminWrites/{id} → { key, at }   (ninguém consegue ler; só é criado com a senha certa)
// Os demais documentos citam esse comprovante em writeId e só são aceitos se ele for válido.
service cloud.firestore {
  match /databases/{database}/documents {

    function todayKey() {
      let t = request.time - duration.value(3, 'h');
      return t.day() * 100 + t.month() + 2003;
    }

    function validProof() {
      return request.resource.data.writeId is string
        && getAfter(/databases/$(database)/documents/adminWrites/$(request.resource.data.writeId)).data.key == todayKey();
    }

    // Lista de projetos
    match /portfolio/projects {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['items', 'writeId', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50
        && validProof();
    }

    // Arquivos (currículo em files/cv e anexos de projetos em files/f_...):
    // metadados + conteúdo dividido em partes (base64)
    function validDeleteProof(fileId) {
      return existsAfter(/databases/$(database)/documents/adminWrites/$('del_' + fileId + '_' + resource.data.version));
    }

    match /files/{fileId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'type', 'size', 'chunks', 'version', 'writeId', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.size is int && request.resource.data.size <= 104857600
        && request.resource.data.chunks is int && request.resource.data.chunks <= 150
        && validProof();
      allow delete: if validDeleteProof(fileId);

      match /chunks/{n} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['data', 'version', 'writeId'])
          && request.resource.data.data is string
          && validProof();
        allow delete: if validDeleteProof(fileId);
      }
    }

    // Comprovantes da senha
    match /adminWrites/{id} {
      allow create: if request.resource.data.keys().hasOnly(['key', 'at'])
        && request.resource.data.key == todayKey();
      allow read, update, delete: if false;
    }
  }
}
